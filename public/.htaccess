<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /icem-acm/

  # Custom 404 within chapter subfolder
  ErrorDocument 404 /icem-acm/404.html

  # Map RSC prefetch requests for Next.js App Router (*.txt -> */index.txt)
  RewriteRule ^(icem-acm|index)\.txt$ index.txt [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^([^.]+)\.txt$ $1/index.txt [L,QSA]

  # Ensure directory requests have trailing slash so relative paths & Apache don't escape /icem-acm/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /icem-acm/$1/ [R=301,L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route directory requests to index.html (e.g. /about/ -> /about/index.html)
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # Map clean URLs to .html files (e.g., /about -> /about.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Fallback to 404.html for any missing pages
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.html [L]
</IfModule>
